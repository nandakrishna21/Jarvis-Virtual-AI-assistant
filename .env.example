# JARVIS environment template
# Copy to backend/.env (or set in your shell / hosting dashboard).
# Never commit real secrets. backend/.env is already gitignored.
#
# NOTE: the backend reads the names below without the JARVIS_ prefix
# (pydantic-settings matches field names). JARVIS_API_KEY is the one exception
# and is also accepted because it maps to a dedicated field.

# Server
APP_NAME=JARVIS
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./jarvis.db

# AI provider: ollama (local) | nvidia | gemini | openrouter
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=512
MAX_CONCURRENT_AI_JOBS=1
LOW_RESOURCE_MODE=true

# Cloud providers - server-side keys only, never shipped to the browser
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# API-key guard. When set, every API call needs X-API-Key.
JARVIS_API_KEY=

# Public resume demo (safe read-only showcase)
DEMO_MODE=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_VOICE_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=240
MAX_MESSAGE_CHARS=4000

# n8n automation (local)
N8N_URL=http://127.0.0.1:5678
N8N_ENABLED=true

# Profile defaults
USER_NAME=Nanda Krishna Talari
USER_LOCATION=Hyderabad, India

# Gmail OAuth (read-only by default)
# Place credentials at C:\JARVIS\credentials\credentials.json and run:
#   cd backend && .\.venv\Scripts\python scripts\gmail_auth.py
