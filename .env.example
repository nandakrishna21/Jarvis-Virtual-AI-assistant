# JARVIS local environment
# Copy to backend/.env (or set in your shell) as needed. Never commit real secrets.

# Server
JARVIS_APP_NAME=JARVIS
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DATABASE_URL=sqlite:///./jarvis.db

# Local AI (default - no paid API required)
JARVIS_LLM_PROVIDER=ollama
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen3:1.7b
JARVIS_OLLAMA_THINK=false
JARVIS_OLLAMA_KEEP_ALIVE=2m
JARVIS_OLLAMA_NUM_CTX=2048
JARVIS_OLLAMA_NUM_PREDICT=512
JARVIS_MAX_CONCURRENT_AI_JOBS=1
JARVIS_LOW_RESOURCE_MODE=true

# Optional cloud AI providers (leave empty to stay fully local)
# JARVIS_LLM_PROVIDER=gemini|openrouter
JARVIS_GEMINI_API_KEY=
JARVIS_OPENROUTER_API_KEY=
JARVIS_OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Optional API-key guard (single-user local mode uses no key)
# When set, POST/PUT/PATCH/DELETE require the header: X-API-Key: <value>
JARVIS_API_KEY=

# n8n automation (local)
JARVIS_N8N_URL=http://127.0.0.1:5678
JARVIS_N8N_ENABLED=true

# Profile defaults
JARVIS_USER_NAME=Nanda Krishna Talari
JARVIS_USER_LOCATION=Hyderabad, India

# Gmail OAuth (read-only by default)
# Place credentials at C:\JARVIS\credentials\credentials.json and run:
#   cd backend && .\.venv\Scripts\python scripts\gmail_auth.py
JARVIS_CREDENTIALS_DIR=C:\JARVIS\credentials
