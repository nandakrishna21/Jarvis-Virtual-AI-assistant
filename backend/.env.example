# JARVIS backend environment
# Copy to backend/.env and fill in your own values. Never commit .env.

# LLM provider: ollama (local) | nvidia | gemini | openrouter
LLM_PROVIDER=nvidia

# NVIDIA NIM (server-side only, never exposed to the browser)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Local API key. Leave empty for a private localhost-only run.
# Set a long random value before exposing the app on a LAN or tunnel.
JARVIS_API_KEY=

# Public resume demo: disables the local key, exposes only safe read + chat
# routes, and rate limits every visitor. Use this for a public hosting URL.
JARVIS_DEMO_MODE=false

# Comma-separated browser origins allowed to call the API during development.
# In production the frontend is served from the same origin, so this can stay empty.
JARVIS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Per-client-IP requests per minute (0 disables a bucket).
JARVIS_RATE_LIMIT_CHAT_PER_MINUTE=30
JARVIS_RATE_LIMIT_VOICE_PER_MINUTE=20
JARVIS_RATE_LIMIT_API_PER_MINUTE=240
JARVIS_MAX_MESSAGE_CHARS=4000

# Apify job scraping (optional, pay-per-result). Enables "Deep Search (Apify)"
# on the Jobs page. Default actor searches public Indeed listings; no login needed.
APIFY_API_KEY=
APIFY_ACTOR=curious_coder/indeed-scraper
APIFY_COUNTRY=in
APIFY_MAX_ITEMS=20
APIFY_PER_MINUTE=3
# Optional full actor input override. Placeholders: {query} {location} {limit} {country}
# APIFY_INPUT_JSON=

# Local-only services
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=2m
